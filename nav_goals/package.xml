<?xml version="1.0"?>
<package format="3">
  <name>nav_goals</name>
  <version>0.1.0</version>
  <description>C++ node that sends a list of waypoints to the Nav2 NavigateToPose action server.</description>
  <maintainer email="salemmlayeh22@gmail.com">Salem Amine Mlayeh</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>rclcpp_action</depend>
  <depend>geometry_msgs</depend>
  <depend>nav2_msgs</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
